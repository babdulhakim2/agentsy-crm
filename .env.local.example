# ─────────────────────────────────────────────────────────────────────
#  Agentsy — environment variables
#  Copy this to .env.local and fill in the values you have.
#  Variables prefixed NEXT_PUBLIC_ are exposed to the browser; everything
#  else stays server-side. The Convex deployment also needs its own copy
#  of the secrets — set them via `npx convex env set NAME value`.
# ─────────────────────────────────────────────────────────────────────

# ── Convex ──
# After running `npx convex dev` once, the CLI prints your deployment URL.
NEXT_PUBLIC_CONVEX_URL="https://example-cute-bear-123.convex.cloud"

# ── Clerk auth ──
# Clerk provides app auth; Convex validates Clerk JWTs for user-scoped data.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Copy the Clerk Frontend API URL from Clerk's Convex integration.
# Example dev format: https://verb-noun-00.clerk.accounts.dev
# Set this both in .env.local and in Convex:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://verb-noun-00.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN="https://example.clerk.accounts.dev"

# Set this on the server side (Next.js .env.local) so /api routes can call Convex.
# The same value is used inside Convex actions to route inbound WhatsApp messages.
# Run `npx convex run groups:ensureDefault '{"name":"New Wok's Cooking","timezone":"Europe/London"}'`
# to seed a group, then paste the returned _id here.
# New Clerk-backed flows use the signed-in user's membership instead.
DEFAULT_GROUP_ID=""

# Optional safety gate for production customer imports via Convex CLI.
# Set this in Convex, not in the browser:
#   npx convex env set CUSTOMER_SEED_SECRET "a-long-random-value"
# Then pass the same value to `customers:seedContacts`.
CUSTOMER_SEED_SECRET=""

# ── OpenRouter (LLM) ──
# Set inside Convex: `npx convex env set OPENROUTER_API_KEY sk-or-v1-...`
# https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."
# Optional: shown in OpenRouter dashboard; defaults to https://agentsy.app
OPENROUTER_REFERER="https://agentsy.app"

# ── Google Business Profile (OAuth) ──
# https://console.cloud.google.com/apis/credentials  →  OAuth 2.0 Client (Web)
# Set the authorized redirect URI to the Convex HTTP site URL, not .convex.cloud:
#   https://<your-convex>.convex.site/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://example-cute-bear-123.convex.site/oauth/google/callback"

# ── WhatsApp Cloud API (Meta Business) ──
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# After app + system user setup:
WHATSAPP_TOKEN=""                  # System user permanent token
WHATSAPP_PHONE_NUMBER_ID=""        # The Phone Number ID from Meta dashboard
WHATSAPP_BUSINESS_ACCOUNT_ID=""    # Optional, for template management
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""   # Any random string — set the same value in Meta webhook config

# Webhook callback URL to register in Meta:
#   <YOUR_CONVEX_URL>/webhooks/whatsapp

# ── Future / not yet wired ──
# RESDIARY_API_KEY=""
# SQUARE_ACCESS_TOKEN=""
# RESEND_API_KEY=""
